# Copy this file to `.env` and fill in real values. `npm run dev`/`npm start`/
# `npm run seed` all load it automatically (via Node's --env-file-if-exists
# flag) — no dotenv dependency needed. Missing .env is fine; every var below
# has a sensible default.

PORT=4000
# Comma-separated list of allowed CORS origins (no spaces needed around commas).
# "*" (the default) allows any origin. Set to the site's and/or app's real
# origin(s) in production; for local dev you'll typically want both the site's
# and the app's dev server ports, e.g.:
#   ALLOWED_ORIGIN=http://localhost:4322,http://localhost:8081
ALLOWED_ORIGIN=*
DB_PATH=./data/words.db

# The server's own base URL, including /v1 — used by `npm run seed-test-words`
# (scripts/seed-test-words.ts) to point it at a different running server
# instead of localhost, and shown in the "Listening on: ..." startup log line.
API_URL=http://localhost:4000/v1

# Optional: enables GET /v1/suggestions. Free key at console.groq.com. Leave
# unset to keep the endpoint off (it returns empty arrays rather than erroring).
GROQ_API_KEY=
SUGGESTIONS_MODEL=openai/gpt-oss-120b

# Optional: retries once via Cerebras (free key at cloud.cerebras.ai) whenever
# Groq specifically returns a 429 — a second, independent free-tier quota.
# Leave unset to keep a Groq 429 surfacing as-is, no fallback attempted.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# How long a GET /v1/suggestions result is cached in memory per language
# before the next request calls the model live again.
SUGGESTIONS_CACHE_TTL_MS=900000

# Max (language, sentence) pairs POST /v1/analyze keeps cached at once — no
# TTL (a sentence's explanation doesn't go stale), so this entry count
# (oldest evicted first) is what bounds memory instead.
ANALYZE_CACHE_MAX_ENTRIES=500

# Per-IP requests/minute allowed on POST /v1/analyze and POST /v1/words
# before a 429 (in-memory, resets on restart — an abuse brake, not an
# accounting system). Independent budgets — one doesn't affect the other.
ANALYZE_PER_MINUTE=10
WORDS_PER_MINUTE=30
