# Copy this file to `.env` and fill in real values. `npm run dev`/`npm start`/
# `npm run seed` all load it automatically (via Node's --env-file-if-exists
# flag) — no dotenv dependency needed. Missing .env is fine; every var below
# has a sensible default.

PORT=4000
# Comma-separated list of allowed CORS origins (no spaces needed around commas).
# "*" (the default) allows any origin. Set to the site's and/or app's real
# origin(s) in production; for local dev you'll typically want both the site's
# and the app's dev server ports, e.g.:
# ALLOWED_ORIGIN=http://localhost:4322,http://localhost:8081
ALLOWED_ORIGIN=*
DB_PATH=./data/words.db

# The server's own base URL, including /v1 — used by `npm run seed-test-words`
# (scripts/seed-test-words.ts) to point it at a different running server
# instead of localhost, and shown in the "Listening on: ..." startup log line.
API_URL=http://localhost:4000/v1

# Optional: enables GET /v1/suggestions, POST /v1/analyze/sentences, and POST
# /v1/analyze/book-notes. Free key, no credit card, at
# aistudio.google.com/apikey. Leave unset to keep all three endpoints off
# (suggestions returns empty arrays, the other two return null, rather than
# erroring). Newer models can carry a much tighter free-tier *daily* cap than
# older ones — check ai.dev/rate-limit for the model below before relying on
# heavy usage.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# How long a GET /v1/suggestions result is cached in memory per language
# before the next request calls the model live again.
SUGGESTIONS_CACHE_TTL_MS=900000

# Max (language, sentence) pairs POST /v1/analyze/sentences, and
# (language, notes) pairs POST /v1/analyze/book-notes, keep cached at once — no TTL
# (neither goes stale), so these entry counts (oldest evicted first) are
# what bound memory instead.
ANALYZE_CACHE_MAX_ENTRIES=500
BOOK_NOTES_CACHE_MAX_ENTRIES=500

# Per-IP requests/minute allowed on POST /v1/analyze/sentences, POST
# /v1/analyze/book-notes, and POST /v1/words before a 429 (in-memory, resets
# on restart — an abuse brake, not an accounting system). Independent
# budgets — none of the three affect each other.
ANALYZE_PER_MINUTE=10
BOOK_NOTES_PER_MINUTE=10
WORDS_PER_MINUTE=30
